{
  "name": "tachyon-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Tachyon UI grid showcase for multiple frameworks",
  "engines": {
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:vue": "pnpm --filter @tachyon-showcase/vue dev",
    "build:vue": "pnpm --filter @tachyon-showcase/vue build",
    "build": "pnpm --filter @tachyon-showcase/vue build",
    "format": "prettier --write \"packages/**/*.{ts,vue,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}